{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nexa-ui.js",
      "require": "./dist/nexa-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.433",
    "@testing-library/vue": "^8.1.0",
    "@unocss/preset-icons": "^0.62.4",
    "@unocss/preset-uno": "^0.62.4",
    "@unocss/transformer-directives": "^0.62.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.3.0",
    "happy-dom": "^15.11.0",
    "typescript": "~5.3.3",
    "unocss": "^0.62.4",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9",
    "vue": "~3.4.38",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "vue": "~3.4.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/nexa-ui"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "@vueuse/motion": "^2.2.6"
  }
}
